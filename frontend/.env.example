# --- Frontend configuration (copy to .env.local and adjust) ---

# Base URL of the backend API. Locally this is the uvicorn server; in production
# set it to your Render URL in the Vercel project settings.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Daily step goal used for streaks and the "goal hit" badge. Keep in sync with the
# backend's DAILY_GOAL if you want them to agree.
NEXT_PUBLIC_DAILY_GOAL=8000

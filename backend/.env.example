# --- Backend configuration (copy to .env and fill in) ---

# REQUIRED. Supabase Session-pooler connection string. Paste it verbatim — the app
# rewrites the scheme to postgresql+psycopg:// at runtime. No SQLite fallback exists.
# Example shape (yours will differ):
DATABASE_URL=postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Comma-separated allowed browser origins for CORS. Include your Vercel URL in prod.
FRONTEND_ORIGIN=http://localhost:3000

# Secret for creating friends via POST /users (sent as the X-Admin-Key header).
# Leave empty to disable the admin endpoint. Generate one with: openssl rand -hex 24
ADMIN_KEY=

# IANA timezone that defines each local "day"/"week"/"month". Week starts Monday.
TIMEZONE=Asia/Kolkata

# Daily step goal used for streaks / goal-hit badges.
DAILY_GOAL=8000
